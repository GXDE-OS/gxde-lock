load("//bazel/qt:qt.bzl", "qt_cc_binary")

package(default_visibility = ["//visibility:public"])

# Session entry point that restarts a crashed locker and shows the crash
# notice. Mirrors src/guard/CMakeLists.txt.
qt_cc_binary(
    name = "gxde-lock-guard",
    srcs = [
        "broken_notice.cc",
        "broken_notice.h",
        "lock_guard.cc",
        "lock_guard.h",
        "main.cc",
        "notice_window.cc",
        "notice_window.h",
    ],
    copts = ["-std=c++20"],
    includes = ["."],
    linkopts = ["-lX11"],
    moc_hdrs = [
        "broken_notice.h",
        "notice_window.h",
    ],
    deps = [
        "//src/common:constants",
        "//src/common:lock_session",
        "//src/lock-classic:wayland_session_lock",
    ],
)
