load("//bazel/qt:qt.bzl", "qt_cc_binary", "qt_qml_module", "qt_rcc")

package(default_visibility = ["//visibility:public"])

# QML lock screen. Mirrors src/lock-neo/CMakeLists.txt: the UI is a flattened
# "Lock" QML module, icons and the virtual keyboard style come from res/, and
# authentication/D-Bus/session-lock come from //src/lock-common:lock_common.
qt_cc_binary(
    name = "gxde-lock-neo",
    srcs = [
        "src/main.cc",
        # Power/keyboard icons and the virtual keyboard style.
        qt_rcc(
            name = "rcc_resources",
            qrc = "res/resources.qrc",
            data = glob(["res/icons/*.svg", "res/vkb-style/**"]),
            init_name = "resources",
        ),
        # Lock screen icons (media card, volume, notifications, user switch).
        qt_rcc(
            name = "rcc_lock_neo",
            qrc = "lock-neo.qrc",
            data = glob(["icons/*.svg"]),
            init_name = "lock_neo_icons",
        ),
        qt_qml_module(
            name = "qml_lock",
            uri = "Lock",
            version = "1.0",
            qml_files = [
                "qml/LockWindow.qml",
                "qml/LockScreen.qml",
                "qml/components/Clock.qml",
                "qml/components/LoginCard.qml",
                "qml/components/LockButton.qml",
                "qml/components/IconButton.qml",
                "qml/components/MediaIndicator.qml",
                "qml/components/NotificationPill.qml",
                "qml/components/ShadowText.qml",
                "qml/components/PowerMenu.qml",
                "qml/components/UserAvatar.qml",
                "qml/components/UserSwitcher.qml",
                "qml/components/VirtualKeyboardPanel.qml",
            ],
            init_name = "lock_qml",
        ),
    ],
    deps = [
        "//src/common:lock_appearance",
        "//src/lock-common:lock_common",
    ],
    linkopts = [
        "-lLayerShellQtInterface",
        "-lQt6WaylandClient",
        "-lwayland-client",
        "-lX11",
    ],
)
