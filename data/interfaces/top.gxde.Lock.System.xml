<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
    <interface name="top.gxde.Lock.System">
        <method name="SetCursor">
            <arg type="s" name="theme" direction="in"/>
            <arg type="b" name="success" direction="out"/>
        </method>
        <method name="SetWallpaperGXDEDefault">
            <arg type="b" name="success" direction="out"/>
        </method>
        <method name="SetWallpaperDDELockDefault">
            <arg type="b" name="success" direction="out"/>
        </method>
        <method name="SetWallpaper">
            <arg type="h" name="wallpaper" direction="in"/>
            <arg type="b" name="success" direction="out"/>
        </method>
        <method name="ClearWallpaper">
            <arg type="b" name="success" direction="out"/>
        </method>
        <method name="SetLockScreenStyle">
            <arg type="s" name="style" direction="in"/>
            <arg type="b" name="success" direction="out"/>
        </method>
        <method name="LockScreenStyle">
            <arg type="s" name="style" direction="out"/>
        </method>
        <signal name="LockScreenStyleChanged">
            <arg type="s" name="style"/>
        </signal>
        <method name="PowerOff"/>
        <method name="Reboot"/>
        <method name="Suspend"/>
        <method name="Hibernate"/>
        <signal name="WallpaperChanged">
            <arg type="s" name="wallpaper"/>
        </signal>
    </interface>
</node>
