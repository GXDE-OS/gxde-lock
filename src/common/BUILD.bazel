load("@rules_cc//cc:defs.bzl", "cc_library")
load("//bazel/qt:qt.bzl", "lock_configure_file", "qt_cc_library")

package(default_visibility = ["//visibility:public"])

# Generated Constants.h
lock_configure_file(
    name = "constants_h",
    src = "Constants.h.in",
    out = "Constants.h",
)

cc_library(
    name = "constants",
    hdrs = ["Constants.h"],
    includes = ["."],
)

# Shared sources pulled into the auth helper.
qt_cc_library(
    name = "common",
    srcs = ["SafeDataStream.cpp"],
    hdrs = [
        "MessageHandler.h",
        "SafeDataStream.h",
    ],
    deps = [":constants"],
)

# Wallpaper, cursor, scale and OS defaults shared by the classic and neo
# lockers.
qt_cc_library(
    name = "lock_appearance",
    srcs = [
        "LockAppearance.cpp",
        "LockCursor.cpp",
        "LockScale.cpp",
        "SystemDefaults.cpp",
    ],
    hdrs = [
        "LockAppearance.h",
        "LockCursor.h",
        "LockScale.h",
        "SystemDefaults.h",
    ],
    linkopts = [
        "-lX11",
        "-lXrandr",
    ],
    deps = [":constants"],
)

# Fingerprint login next to the password: the state machine shared by the lock
# screens, and the fprintd probe.
qt_cc_library(
    name = "fingerprint_session",
    srcs = ["FingerprintSession.cpp"],
    hdrs = ["FingerprintSession.h"],
    includes = ["."],
    moc_hdrs = ["FingerprintSession.h"],
)

qt_cc_library(
    name = "fingerprint_probe",
    srcs = ["FingerprintProbe.cpp"],
    hdrs = ["FingerprintProbe.h"],
    includes = ["."],
)

# logind lock/unlock requests and the lock-state flag read by
# gxde-lock-guard; shared by the lockers and the guard.
qt_cc_library(
    name = "lock_session",
    srcs = [
        "LockState.cpp",
        "LockTranslations.cpp",
        "LogindSession.cpp",
    ],
    hdrs = [
        "LockState.h",
        "LockTranslations.h",
        "LogindSession.h",
    ],
    includes = ["."],
    deps = [":constants"],
    moc_hdrs = ["LogindSession.h"],
)
