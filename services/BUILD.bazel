load("@rules_pkg//pkg:mappings.bzl", "pkg_files")

package(default_visibility = ["//visibility:public"])

# PAM configs (Debian variants), installed to /etc/pam.d with canonical names.
pkg_files(
    name = "pam_pkg",
    srcs = [
        "debian.gxde-lock.pam",
        "debian.gxde-lock-fingerprint.pam",
    ],
    prefix = "/etc/pam.d",
    renames = {
        "debian.gxde-lock.pam": "gxde-lock",
        "debian.gxde-lock-fingerprint.pam": "gxde-lock-fingerprint",
    },
)
