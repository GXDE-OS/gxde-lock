load("@rules_pkg//pkg:mappings.bzl", "pkg_files")
load("//bazel/qt:qt.bzl", "lock_configure_file")

package(default_visibility = ["//visibility:public"])

# D-Bus system policy of gxde-lock-system.
pkg_files(
    name = "dbus_pkg",
    srcs = ["top.gxde.Lock.conf"],
    prefix = "/usr/share/dbus-1/system.d",
)

pkg_files(
    name = "omg_pkg",
    srcs = ["configs/OMG.conf"],
    prefix = "/etc/gxde-lock",
    renames = {"configs/OMG.conf": "OMG.conf"},
)

lock_configure_file(
    name = "configure_lock_autostart",
    src = "gxde-lock.desktop.in",
    out = "gxde-lock.desktop",
)

lock_configure_file(
    name = "configure_session_service",
    src = "top.gxde.Lock.service.in",
    out = "session/top.gxde.Lock.service",
)

lock_configure_file(
    name = "configure_system_service",
    src = "top.gxde.Lock.System.service.in",
    out = "system/top.gxde.Lock.service",
)

pkg_files(
    name = "session_integration_pkg",
    srcs = [
        "gxde-lock.desktop",
        "session/top.gxde.Lock.service",
        "system/top.gxde.Lock.service",
    ],
    prefix = "/",
    renames = {
        "gxde-lock.desktop": "etc/xdg/autostart/gxde-lock.desktop",
        "session/top.gxde.Lock.service": "usr/share/dbus-1/services/top.gxde.Lock.service",
        "system/top.gxde.Lock.service": "usr/share/dbus-1/system-services/top.gxde.Lock.service",
    },
)
