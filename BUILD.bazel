load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

package(default_visibility = ["//visibility:public"])

# Lock screens go to /usr/bin.
pkg_files(
    name = "bin_pkg",
    srcs = [
        "//src/lock-classic:gxde-lock-classic",
        "//src/lock-neo:gxde-lock-neo",
    ],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "/usr/bin",
)

# Helper binaries go to /usr/libexec.
pkg_files(
    name = "libexec_pkg",
    srcs = [
        "//src/auth-helper:gxde-lock-auth-helper",
        "//src/guard:gxde-lock-guard",
        "//src/system:gxde-lock-system",
    ],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "/usr/libexec",
)

# Full deployable install tree, extracted at / on the target.
pkg_tar(
    name = "gxde-lock-dist",
    srcs = [
        ":bin_pkg",
        ":libexec_pkg",
        "//data:dbus_pkg",
        "//data:omg_pkg",
        "//data:session_integration_pkg",
        "//services:pam_pkg",
    ],
    extension = "tar",
)
